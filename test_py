import pytest
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

# Pytest Fixture for Browser Setup and Teardown
@pytest.fixture
def driver():
    # Setup: Initialize Chrome WebDriver
    driver = webdriver.Chrome()
    driver.implicitly_wait(10) # Implicit Wait (10s)
    driver.maximize_window()
    
    yield driver # Test Runs Here
    
    # Teardown: Close Browser Session
    driver.quit()

# Test Case 1: Form Fill and Submit
def test_user_login(driver):
    # 1. Navigate to target URL
    driver.get("https://example.com/login")
    
    # 2. Locate elements and perform actions
    driver.find_element(By.ID, "username").send_keys("test_student")
    driver.find_element(By.ID, "password").send_keys("secret123")
    driver.find_element(By.CSS_SELECTOR, "button[type='submit']").click()
    
    # 3. Explicit Wait for Dynamic Element
    welcome_text = WebDriverWait(driver, 5).until(
        EC.presence_of_element_located((By.ID, "welcome-message"))
    )
    
    # 4. Assertions (Pytest Verification)
    assert "Dashboard" in driver.title
    assert welcome_text.text == "Welcome, test_student"

# Test Case 2: Page Element Verification
def test_page_elements(driver):
    driver.get("https://example.com")
    heading = driver.find_element(By.TAG_NAME, "h1")
    
    # Assertions
    assert heading.is_displayed()
    assert heading.text == "Example Domain"